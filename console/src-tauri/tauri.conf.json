{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Team Runtime",
  "version": "0.3.0",
  "identifier": "local.aiteam.console",
  "build": {"frontendDist": "../dist"},
  "app": {
    "windows": [],
    "security": {"csp":"default-src 'self'; connect-src 'self'"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {"../../build/desktop-kernel/ai-team-kernel/": "kernel/"},
    "windows": {"nsis": {"installMode": "currentUser"}}
  }
}
