# No credentials are required for mock mode. Never commit real secrets.
AI_TEAM_CODEX=codex
# Configure DSH separately through its official SDK; never extract desktop credentials.
# Optional real DSH: explicitly select a dedicated runtime home and official CLI.
# DSH_HOME=/path/to/dedicated/runtime-home
# AI_TEAM_DSH_BIN=/path/to/official/dsh
# AI_TEAM_DSH_MODEL=deepseek-v4-flash
# Supply DEEPSEEK_API_KEY through the launching environment or official DSH setup.
# DEEPSEEK_API_KEY=<your-deepseek-api-key>
# V0.1.2 real adapter requires this variable in its launching environment.
# This application does not load .env automatically or read desktop credentials.

# V0.1.5 WorkBuddy: project-defined names, never desktop installation credentials.
# AI_TEAM_WORKBUDDY_CLIENT_ID=<approved-application-id>
# AI_TEAM_WORKBUDDY_REDIRECT_URI=<exact-approved-https-callback>
# Set to 1 only AFTER the platform confirms this application's deployment/permissions.
# AI_TEAM_WORKBUDDY_DEPLOYMENT_APPROVED=0
# Secrets are entered only on an approved trusted OAuth server, never in this file.
